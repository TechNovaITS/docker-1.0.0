# MySQL - usuario root
MYSQL_ROOT_PASSWORD=test

# MySQL - base de datos y usuario de la app
MYSQL_DATABASE=test
MYSQL_APP_USER=test
MYSQL_APP_PASSWORD=test

# Grafana - usuario admin
GRAFANA_ADMIN_USER=test
GRAFANA_ADMIN_PASSWORD=test

# ProxySQL - admin
PROXYSQL_ADMIN_PASSWORD=test

# ProxySQL - monitor (usuario que chequea salud de primary/replica)
PROXYSQL_MONITOR_PASSWORD=test

# ProxySQL - usuario que usa Grafana para consultar la DB (datasource, no el login web)
GRAFANA_DB_USER=test
GRAFANA_DB_PASSWORD=test
