# MySQL - usuario root
MYSQL_ROOT_PASSWORD=

# MySQL - base de datos y usuario de la app
MYSQL_DATABASE=
MYSQL_APP_USER=
MYSQL_APP_PASSWORD=

# Grafana - usuario admin
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ProxySQL - admin
PROXYSQL_ADMIN_PASSWORD=papu

# ProxySQL - monitor (usuario que chequea salud de primary/replica)
PROXYSQL_MONITOR_PASSWORD=papu

# ProxySQL - usuario que usa Grafana para consultar la DB (datasource, no el login web)
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASSWORD=papu
